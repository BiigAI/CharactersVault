<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>CharactersVault</AssemblyName>
    <RootNamespace>CharacterVault</RootNamespace>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <!-- Suppress auto-generated AssemblyInfo so Plugin.cs controls version -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Configurations>Debug;Release</Configurations>
  </PropertyGroup>

  <!--
    All DLLs referenced here must be copied to the libs/ folder.
    See libs/COPY_DLLS_HERE.md for exact paths.
  -->
  <ItemGroup>
    <!--
      Required to target .NET Framework 4.7.2 when only the .NET 8 SDK is installed.
      PrivateAssets=all means this is a build-time-only dependency — not shipped with the mod.
    -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
    <Reference Include="assembly_valheim">
      <HintPath>libs\assembly_valheim.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="assembly_utils">
      <HintPath>libs\assembly_utils.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BepInEx">
      <HintPath>libs\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>libs\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>libs\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>libs\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!--
    Post-build: automatically deploy the compiled DLL to BepInEx plugins folder.
    Update the path below to match your Valheim server installation.
  -->
  <Target Name="DeployToServer" AfterTargets="Build" Condition="'$(Configuration)' == 'Debug'">
    <PropertyGroup>
      <ValheimPluginsPath>C:\ValheimServer\BepInEx\plugins\CharactersVault\</ValheimPluginsPath>
    </PropertyGroup>
    <ItemGroup>
      <DeployFiles Include="$(TargetDir)*.dll;$(TargetDir)*.pdb" />
    </ItemGroup>
    <MakeDir Directories="$(ValheimPluginsPath)" />
    <Delete Files="C:\ValheimServer\BepInEx\plugins\CharacterVault\CharacterVault.dll" />
    <Copy
      SourceFiles="@(DeployFiles)"
      DestinationFolder="$(ValheimPluginsPath)"
      SkipUnchangedFiles="true" />
    <Message Text="[CharactersVault] Deployed to $(ValheimPluginsPath)" Importance="high" />
  </Target>

</Project>
